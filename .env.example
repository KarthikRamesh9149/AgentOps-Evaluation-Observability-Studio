APP_ENV=local
# Required outside the explicit local demo. Comma-separated token_id:role:sha256.
# Generate a secret and digest; configure only the digest, then send token_id.secret.
API_TOKENS=
# For an offline localhost-only demo, set this to true instead of configuring a token.
# It is permitted only when APP_ENV=local and defaults to false.
ALLOW_INSECURE_LOCAL_DEMO=false
DATA_DIR=data
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_SMALL_MODEL=gpt-4.1-nano
OPENAI_JUDGE_MODEL=gpt-4.1-mini
OPENAI_ENABLE_JUDGE=false
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_OUTPUT_TOKENS=700
MOCK_PROVIDER_LATENCY_MS=35
DEFAULT_QUALITY_GATE_PATH=quality_gates.yaml
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
MAX_REQUEST_BYTES=1048576
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
